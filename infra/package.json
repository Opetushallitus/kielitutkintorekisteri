{
  "name": "infra",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "infra": "bin/infra.js"
  },
  "engines": {
    "node": "^24",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "login": "aws sso login",
    "diff/dev": "TAG=\"$(git rev-parse main)\" npx cdk diff --exclusively \"Dev/**\"",
    "deploy/dev": "TAG=\"$(git rev-parse main)\" npx cdk deploy --exclusively \"Dev/**\""
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.2",
    "aws-cdk": "2.1141.0",
    "jest": "^30.0.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.882.0",
    "@aws-sdk/client-sqs": "^3.882.0",
    "@aws-sdk/client-ssm": "^3.882.0",
    "@aws-sdk/client-sts": "^3.882.0",
    "@aws-sdk/credential-providers": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.882.0",
    "@types/aws-lambda": "^8.10.152",
    "aws-cdk-lib": "2.270.0",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  }
}
